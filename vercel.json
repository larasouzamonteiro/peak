
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "front",
  "regions": ["sfo1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "front/html/404.html",
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/html/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}

